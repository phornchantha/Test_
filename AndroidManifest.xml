<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/book"
        android:label="@string/app_name"
        android:roundIcon="@drawable/book"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppProject">

        <activity
            android:name="com.cscorner.appproject.Language"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.cscorner.appproject.MainActivity"
            android:exported="false" />
        <activity
            android:name="com.cscorner.appproject.Question"
            android:exported="false" />
        <activity
            android:name="com.cscorner.appproject.GameOver"
            android:exported="false" />
        <activity
            android:name="com.cscorner.appproject.GameWin"
            android:exported="false" />
        <activity
            android:name="com.cscorner.appproject.GradientActivity"
            android:exported="false" />
        <activity
            android:name="com.cscorner.appproject.UserProfileActivity"
            android:exported="false" />

    </application>

</manifest>
